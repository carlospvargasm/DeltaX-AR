<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#111C18">
    <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" />
    <com.deltax.ar.AROverlayView android:id="@+id/overlay" android:layout_width="match_parent" android:layout_height="match_parent" />
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="28dp" android:padding="10dp"
        android:text="APUNTA A UNA LÁMINA DELTAX" android:textColor="#FFF7E8" android:textSize="13sp" android:background="#99111C18" />
    <TextView android:id="@+id/logo" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="24dp" android:padding="12dp"
        android:text="ΔX" android:textStyle="bold" android:textSize="24sp" android:textColor="#D9B45B" />
</FrameLayout>
